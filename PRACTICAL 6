#include <stdio.h>
#include <stdlib.h>
struct Node {
int data;
struct Node* next;
};
struct Node* top = NULL;
void push(int value) {
struct Node* newNode = (struct Node*)malloc(sizeof(struct Node));

if (newNode == NULL) {
printf("Memory allocation failed\n");
return;
}else{
newNode->data = value;
newNode->next = top;
top = newNode;
printf("Pushed %d onto the stack\n", value);}
}
void pop() {
if (top == NULL) {
printf("Stack is empty \n");
return;

}else
{
struct Node *temp=top;
printf("Popped %d from the stack\n", top->data);
top = top->next;
free(temp);
}}
void display()
{
if (top == NULL)
{
printf("Stack is empty\n");
}
else
{
struct Node* temp = top;
printf("Stack elements: ");
while (temp != NULL)
{
printf("%d ", temp->data);
temp = temp->next;
} printf("\n");
}
}
int main()
{
push(1);
push(2);
push(3);
push(4);
push(5);
display();
pop();

return 0;
}
